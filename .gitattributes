*.sh text eol=lf
*.dart text eol=lf
# Flutter gen-l10n follows pubspec.yaml's line endings.
**/pubspec.yaml text eol=lf
apps/viewer/macos/Flutter/GeneratedPluginRegistrant.swift text eol=lf
apps/viewer/windows/flutter/generated_* text eol=lf
.githooks/* text eol=lf
.github/workflows/* text eol=lf
third_party/ffmpeg/licenses/** text eol=lf
third_party/native-sdk/** text eol=lf
third_party/native-sdk.lock.json text eol=lf
native/hdr_codecs/CMakeLists.txt text eol=lf
tool/build/*sdk*.ps1 text eol=lf
tool/build/ffmpeg_dependencies.ps1 text eol=lf
tool/build/build_ffmpeg.ps1 text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.apng binary
*.avif binary
*.heic binary
*.heif binary
*.bmp binary
*.tif binary
*.tiff binary
*.dds binary
*.jxl binary
*.hdr binary
*.exr binary
*.ico binary
*.icns binary
*.psd binary
*.psb binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.icc binary
*.icm binary
*.pdf binary

apps/viewer/testdata/** filter=lfs diff=lfs merge=lfs -text
# Text fixtures remain reviewable and byte-exact; Markdown is documentation.
apps/viewer/testdata/**/*.md -filter diff merge text eol=lf
apps/viewer/testdata/**/*.svg -filter diff merge -text
apps/viewer/testdata/**/*.json -filter diff merge -text
apps/viewer/testdata/**/*.txt -filter diff merge -text
