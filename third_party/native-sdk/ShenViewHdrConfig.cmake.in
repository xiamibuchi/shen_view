if(CMAKE_CXX_COMPILER_VERSION VERSION_LESS "@CMAKE_CXX_COMPILER_VERSION@")
  message(FATAL_ERROR "HDR SDK requires MSVC @CMAKE_CXX_COMPILER_VERSION@ or newer")
endif()
get_filename_component(_hdr_root "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
function(_hdr_import target library)
  add_library(${target} STATIC IMPORTED GLOBAL)
  set_target_properties(${target} PROPERTIES
    IMPORTED_LOCATION "${_hdr_root}/lib/${library}"
    INTERFACE_INCLUDE_DIRECTORIES "${_hdr_root}/include")
endfunction()
_hdr_import(viewer_lcms viewer_lcms.lib)
_hdr_import(viewer_raw_lib viewer_raw_lib.lib)
_hdr_import(viewer_jpeg_static jpeg-static.lib)
_hdr_import(shenview_aom aom.lib)
_hdr_import(avif avif_internal.lib)
_hdr_import(uhdr-static uhdr-static.lib)
set_target_properties(viewer_raw_lib PROPERTIES INTERFACE_COMPILE_DEFINITIONS LIBRAW_NODLL)
set_target_properties(avif PROPERTIES INTERFACE_LINK_LIBRARIES shenview_aom)
set_target_properties(uhdr-static PROPERTIES INTERFACE_LINK_LIBRARIES viewer_jpeg_static)
unset(_hdr_root)
